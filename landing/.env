# Public, non-secret build-time config (Vite only exposes VITE_* vars to the client).
# The dashboard link needs no config: in production it is the same-origin path /app/.
# For `npm run dev` without the backend, VITE_DEV_DASHBOARD_URL (in .env.local) overrides
# the default http://localhost:8000/app/.
VITE_GITHUB_URL=https://github.com/LuckyAnsari22/26160
